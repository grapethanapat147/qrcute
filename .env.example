# ---------------------------------------------------------------------------
# ชื่อแบรนด์และโดเมน — ยังเป็น placeholder จนกว่าจะล็อกชื่อจริง
# ดู docs/decisions/0002-brand-placeholder.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="QR Cute"
NEXT_PUBLIC_SITE_SHORT_NAME="QRCute"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase
#
# ค่าด้านล่างเป็นของ stack ที่รันในเครื่อง (bun run db:start) ไม่ใช่ความลับ
# Supabase ใช้ค่าชุดเดียวกันนี้กับทุกเครื่องที่รัน local อยู่แล้ว
# port ใช้ช่วง 547xx เพราะเครื่องนี้มี Supabase ของโปรเจกต์อื่นรันอยู่ด้วย
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54721"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
# ใช้เฉพาะฝั่ง server เท่านั้น ห้ามหลุดไปฝั่ง client
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# เกลือสำหรับ hash IP ของผู้สแกน
#
# ⚠️ ต้องเป็นค่าสุ่มยาว ๆ และเก็บเป็นความลับ ถ้าค่านี้รั่วพร้อมฐานข้อมูล
# จะไล่ hash กลับเป็น IP ได้ (ดู docs/decisions/0006-scan-analytics-privacy.md)
# ถ้าเว้นว่าง ระบบจะไม่บันทึก ip_hash เลย
# ---------------------------------------------------------------------------
SCAN_IP_SALT="เปลี่ยนเป็นค่าสุ่มก่อนขึ้น production"

# ---------------------------------------------------------------------------
# Analytics — เปิดเฉพาะ production
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Opn Payments (Omise) — ดู docs/decisions/0007-payment-gateway.md
#
# public key ใช้ฝั่งเบราว์เซอร์เพื่อแลกข้อมูลบัตรเป็น token (ข้อมูลบัตรต้องไม่ผ่านเซิร์ฟเวอร์เรา)
# secret key และ webhook secret ใช้ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_ นำหน้าเด็ดขาด
#
# OPN_LIVEMODE บังคับว่า endpoint นี้ยอมรับเหตุการณ์โหมดไหน
# ถ้าไม่ตั้ง จะยึดตาม NODE_ENV — production = โหมดจริง
# กันกรณีตั้ง webhook ทั้งสองโหมดชี้มาที่เดียวกัน แล้วการกดทดสอบกลายเป็นแจกแพ็กเกจจริงฟรี
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_OPN_PUBLIC_KEY=
# OPN_SECRET_KEY=
# OPN_WEBHOOK_SECRET=
# OPN_LIVEMODE=false

# ---------------------------------------------------------------------------
# งานรายวัน (vercel.json → /api/cron/daily)
#
# Vercel ส่งค่านี้มาใน header Authorization: Bearer <CRON_SECRET>
# ถ้าเว้นว่าง เส้นทาง cron จะตอบ 401 ทุกครั้ง — ตั้งใจให้เป็นแบบนั้น
# ---------------------------------------------------------------------------
# CRON_SECRET=
